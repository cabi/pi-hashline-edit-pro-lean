{
  "name": "pi-hashline-edit-pro-lean",
  "version": "0.1.0",
  "description": "Token-lean wrapper around pi-hashline-edit-pro: identical features, trimmed tool descriptions and schemas. Upstream is a pinned dependency, wrapped via Proxy.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "measure": "tsx scripts/measure.ts"
  },
  "dependencies": {
    "pi-hashline-edit-pro": "6.3.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "js-tiktoken": "^1.0.20",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
